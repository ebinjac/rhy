{
  "name": "rhythm",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev:api": "cd services/api && go run ./cmd/api",
    "dev": "turbo dev",
    "migrate:api": "cd services/api && go run ./cmd/migrate",
    "migrations:check": "node scripts/check-migration-parity.mjs",
    "hydra:check": "node scripts/check-hydra-deployment.mjs",
    "test:api": "cd services/api && go test ./...",
    "test:scenarios": "node --test --test-concurrency=1 tests/scenarios/**/*.test.mjs",
    "test:scenarios:ci": "node tests/scenarios/run-ci.mjs",
    "test-lab:run": "cd test-lab && ./scripts/run.sh",
    "test-lab:test": "cd test-lab && ./scripts/test.sh",
    "test-lab:certs": "cd test-lab && ./scripts/generate-test-certs.sh",
    "test-lab:integration": "cd services/api && TEST_LAB_URL=http://localhost:9080 go test -tags=testlab_integration ./internal/runs",
    "test-lab:register": "node test-lab/scripts/register-rhythm-monitors.mjs",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "perf:budgets": "npm run build --workspace=web && node scripts/check-web-budgets.mjs",
    "perf:scale": "k6 run tests/performance/rhythm-scale.js"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
