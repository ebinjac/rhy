# Upload separately to the rhythm-frontdoor Vault configuration in every environment.
# Never commit populated values. Hydra mounts the result at:
# /opt/epaas/vault/secrets/secrets
RHYTHM_DATABASE_URL=<POSTGRESQL_TRANSACTION_POOL_TLS_URL>
RHYTHM_REDIS_URL=<REDIS_ENTERPRISE_TLS_URL>
RHYTHM_REDIS_USERNAME=<REDIS_USERNAME>
RHYTHM_REDIS_PASSWORD=<REDIS_PASSWORD>
RHYTHM_SECRETS_ENCRYPTION_KEY=<SHARED_32_BYTE_BASE64_OR_HEX_KEY>
RHYTHM_SCRIPT_RUNNER_TOKEN=<FRONTDOOR_LOCAL_SCRIPT_RUNNER_TOKEN>
RHYTHM_BROWSER_RUNNER_TOKEN=<SHARED_BROWSER_RUNNER_TOKEN>
RHYTHM_ARTIFACT_STORE_BUCKET=<EXISTING_S3_BUCKET>
RHYTHM_ARTIFACT_STORE_REGION=<AWS_REGION>
RHYTHM_ARTIFACT_STORE_KMS_KEY_ID=<KMS_KEY_ID>
RHYTHM_VAULT_ADDR=<APPLICATION_SECRET_VAULT_URL>
RHYTHM_VAULT_TOKEN=<APPLICATION_SECRET_VAULT_READ_WRITE_TOKEN>
RHYTHM_ADMIN_GROUPS=<CORPORATE_ADMIN_GROUPS>
RHYTHM_EDITOR_GROUPS=<CORPORATE_EDITOR_GROUPS>
RHYTHM_OPERATOR_GROUPS=<CORPORATE_OPERATOR_GROUPS>
RHYTHM_VIEWER_GROUPS=<CORPORATE_VIEWER_GROUPS>
