# Upload separately to the rhythm-browser-executor Vault configuration in every environment.
# Never commit populated values. Hydra mounts the result at:
# /opt/epaas/vault/secrets/secrets
RHYTHM_DATABASE_URL=<POSTGRESQL_TRANSACTION_POOL_TLS_URL>
RHYTHM_SECRETS_ENCRYPTION_KEY=<SHARED_32_BYTE_BASE64_OR_HEX_KEY>
RHYTHM_BROWSER_RUNNER_TOKEN=<SHARED_BROWSER_RUNNER_TOKEN>
RHYTHM_ARTIFACT_STORE_URL=<S3_ENDPOINT_URL>
RHYTHM_ARTIFACT_STORE_ACCESS_KEY=<S3_ACCESS_KEY>
RHYTHM_ARTIFACT_STORE_SECRET_KEY=<S3_SECRET_KEY>
RHYTHM_ARTIFACT_STORE_BUCKET=<EXISTING_S3_BUCKET>
RHYTHM_ARTIFACT_STORE_REGION=<AWS_REGION>
RHYTHM_ARTIFACT_STORE_KMS_KEY_ID=<KMS_KEY_ID>
