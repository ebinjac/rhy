# Copy to .env (gitignored) and fill in values. Compose interpolates these into the Rhythm services.
RHYTHM_ARTIFACT_STORE_PROVIDER=s3
RHYTHM_ARTIFACT_STORE_URL=
RHYTHM_ARTIFACT_STORE_ACCESS_KEY=
RHYTHM_ARTIFACT_STORE_SECRET_KEY=
RHYTHM_ARTIFACT_STORE_BUCKET=
RHYTHM_ARTIFACT_STORE_REGION=phx
RHYTHM_ARTIFACT_STORE_PATH_STYLE=true
RHYTHM_ARTIFACT_STORE_AUTO_CREATE=false

# Optional local Ask Rhythm provider (OpenRouter). Leave blank to configure in the UI at /configuration?kind=ai.
# The live key belongs in gitignored .env only — never commit it.
RHYTHM_AI_OPENROUTER_API_KEY=
RHYTHM_AI_OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
